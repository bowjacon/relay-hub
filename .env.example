# HTTP server
PORT=4173
STATE_FILE=data/relay-hub-state.json
# Long-request timeout in milliseconds (default 180000, max 600000)
REQUEST_TIMEOUT_MS=180000

# Optional stable cache bucket for OpenAI-compatible upstreams. Third-party
# sources use `relay-hub` when this is unset. Keep it stable per deployment;
# the relay adds source/model/agent suffixes automatically.
# RELAY_PROMPT_CACHE_KEY=relay-hub

# Optional upstream proxy fallback. Prefer setting the proxy in the web UI per server.
# http_proxy=http://127.0.0.1:1080

# Runtime log controls
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE_MB=20
LOG_MAX_FILES=10
LOG_RETENTION_DAYS=14
